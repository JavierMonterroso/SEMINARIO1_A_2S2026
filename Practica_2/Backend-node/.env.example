PORT=3000

DB_HOST=taskflow-db.clagayom87id.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=taskflowadmin
# Completar manualmente en .env; no subir la contrasena al repositorio.
DB_PASSWORD=

# Colocar la misma clave aleatoria larga en los dos backends.
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=24

STORAGE_PROVIDER=s3
AWS_REGION=us-east-2
# Nombre del bucket de archivos, pendiente de crear.
AWS_S3_BUCKET=

# Completar solo cuando STORAGE_PROVIDER=azure.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
