[Unit]
Description=TaskFlow + CloudDrive - Backend Python
After=network-online.target
Wants=network-online.target

[Service]
User=__SERVICE_USER__
WorkingDirectory=__BACKEND_DIR__
ExecStart="__BACKEND_DIR__/venv/bin/python" -m app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
