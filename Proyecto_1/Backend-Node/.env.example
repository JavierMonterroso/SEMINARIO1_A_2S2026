PORT=3000

# Amazon RDS (PostgreSQL)
DB_HOST=
DB_PORT=5432
DB_NAME=semisocial
DB_USER=
# Completar manualmente en .env; no subir la contrasena al repositorio.
DB_PASSWORD=

# Misma clave aleatoria en los dos backends (minimo 32 caracteres): openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=8

# Las credenciales de AWS las entrega el rol role-ec2-backend de la instancia.
AWS_REGION=us-east-1

# Cognito: User Pool con inicio de sesion por correo y app client SIN secreto.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API Gateway -> Lambda upload-image -> S3
IMAGE_UPLOAD_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/images
IMAGE_UPLOAD_API_KEY=
IMAGES_BUCKET=semi1proyecto-g#
IMAGES_BASE_URL=https://semi1proyecto-g#.s3.us-east-1.amazonaws.com

# Amazon Lex V2
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=es_US
